config_version=5

[application]

config/name="Ember"
config/icon="res://Icon.PNG"
run/main_scene="res://engine/inicio/Abertura.tscn"
config/features=PackedStringArray("4.2")

[autoload]

Config="*res://engine/config/Config.gd"
Textos="*res://engine/config/Textos.gd"
Audio="*res://engine/sons/Audio.gd"
Navegacao="*res://engine/navegacao/Navegacao.gd"
Catalogo="*res://engine/catalogo/Catalogo.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true